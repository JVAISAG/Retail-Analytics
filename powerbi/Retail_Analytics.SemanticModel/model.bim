        ],
        "lineageTag": "4420d03b-31e5-4911-9f63-d22fa525ccd5",
        "measures": [
          {
            "name": "Gross Sales GBP",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Sales metrics",
            "expression": "DIVIDE(CALCULATE(SUM(Ledger[amount_pence]),Ledger[kind]=\"sale\"),100)",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "10e4efb1-e784-42b2-9aa7-0e13f1e059ed"
          },
          {
            "name": "Returns GBP",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Sales metrics",
            "expression": "-DIVIDE(CALCULATE(SUM(Ledger[amount_pence]),Ledger[kind]=\"return\"),100)",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "6ea88605-ddf2-4725-9dfd-f3d92e0318d1"
          },
          {
            "name": "Net Sales GBP",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Sales metrics",
            "expression": "[Gross Sales GBP]-[Returns GBP]",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "20c3f3ad-793f-4056-aea5-62d4f49b39e0"
          },
          {
            "name": "Orders",
            "displayFolder": "Sales metrics",
            "expression": "CALCULATE(DISTINCTCOUNT(Ledger[invoice]),Ledger[kind]=\"sale\")",
            "formatString": "#,0",
            "lineageTag": "11a77f5c-596d-4460-8a4d-459df6efa6b6"
          },
          {
            "name": "Average Order Value GBP",
            "displayFolder": "Sales metrics",
            "expression": "DIVIDE([Gross Sales GBP],[Orders])",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "5128971a-fbf6-4eba-91ee-e0558bdc1356"
          },
          {
            "name": "Identified Buyers",
            "displayFolder": "Sales metrics",
            "expression": "CALCULATE(DISTINCTCOUNT(Ledger[customer_id]),Ledger[kind]=\"sale\",Ledger[customer_id]<>BLANK())",
            "formatString": "#,0",
            "lineageTag": "98e64377-2433-4b59-b977-5d2f18feeff7"
          },
          {
            "name": "Returns to Gross Sales",
            "displayFolder": "Sales metrics",
            "expression": "DIVIDE([Returns GBP],[Gross Sales GBP])",
            "formatString": "0.0%",
            "lineageTag": "5ab48fcf-ea20-496c-b006-d104849ef019"
          },
          {
            "name": "Country Rank",
            "displayFolder": "Sales metrics",
            "expression": "RANKX(ALLSELECTED(Ledger[country]),[Net Sales GBP],,DESC,Dense)",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "3c28f8c4-87c1-460e-a5e3-ba5f43327e88"
          }
        ],
        "partitions": [
          {
            "name": "Ledger",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Binary.Decompress(",
                "        File.Contents(ProjectRoot & \"\\data\\processed\\ledger.csv.gz\"),",
                "        Compression.GZip",
                "    ),",
                "    Parsed = Csv.Document(",
                "        Source,",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                "    ),",
                "    Headers = Table.PromoteHeaders(",
                "        Parsed,",
                "        [PromoteAllScalars=true]",
                "    ),",
                "    Types = Table.TransformColumnTypes(Headers, {",
                "        {\"source_sheet\", type text},",
                "        {\"source_row\", Int64.Type},",
                "        {\"invoice\", type text},",
                "        {\"stock_code\", type text},",
                "        {\"description\", type text},",
                "        {\"quantity\", Int64.Type},",
                "        {\"invoice_date\", type datetime},",
                "        {\"order_date\", type date},",
                "        {\"month\", type text},",
                "        {\"unit_price_gbp\", type number},",
                "        {\"amount_pence\", Int64.Type},",
                "        {\"customer_id\", type text},",
                "        {\"country\", type text},",
                "        {\"kind\", type text}",
                "    }, \"en-GB\"),",
                "    MissingCustomers = Table.ReplaceValue(",
                "        Types, \"\", null, Replacer.ReplaceValue, {\"customer_id\"}",
                "    )",
                "in",
                "    MissingCustomers"
              ],
              "type": "m"
            }
          }
        ]
      },
