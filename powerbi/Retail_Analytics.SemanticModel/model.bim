        "description": "Monthly first-purchase cohorts; unobserved future cells remain blank. Intentionally disconnected from sales slicers.",
        "lineageTag": "9381e47d-ac24-409f-968e-5c10f02d0132",
        "measures": [
          {
            "name": "Cohort Retention",
            "displayFolder": "Snapshot metrics",
            "expression": "IF(HASONEVALUE(Cohorts[cohort])&&HASONEVALUE(Cohorts[age])&&MAX(Cohorts[observed])=1,DIVIDE(MAX(Cohorts[active_customers]),MAX(Cohorts[cohort_customers])),BLANK())",
            "formatString": "0.0%",
            "lineageTag": "e6332bad-ccfd-485e-9c68-8f22a4451b0d"
          }
        ],
        "partitions": [
          {
            "name": "cohort_retention",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ProjectRoot & \"\\data\\processed\\cohort_retention.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"cohort\", type text}, {\"age\", Int64.Type}, {\"cohort_customers\", Int64.Type}, {\"active_customers\", Int64.Type}, {\"retention\", type number}, {\"observed\", Int64.Type}}, \"en-GB\")",
                "in",
                "    Types"
              ],
              "type": "m"
            }
          }
        ]
      },
