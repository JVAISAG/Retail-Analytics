        "description": "Full-history RFM customer snapshot as at 10 December 2011. Intentionally disconnected from sales date and country slicers.",
        "lineageTag": "e78a60db-7111-46d8-8806-490946b8008d",
        "measures": [
          {
            "name": "Snapshot Buyers",
            "displayFolder": "Snapshot metrics",
            "expression": "COUNTROWS(Customers)",
            "formatString": "#,0",
            "lineageTag": "776d5886-a9a6-4ddf-a2ff-5253733b4684"
          },
          {
            "name": "Snapshot Repeat Buyers",
            "displayFolder": "Snapshot metrics",
            "expression": "CALCULATE(COUNTROWS(Customers),Customers[frequency]>=2)",
            "formatString": "#,0",
            "lineageTag": "fda7027f-4b3d-419c-a775-7b7e8b58f537"
          },
          {
            "name": "Snapshot Repeat Buyer Rate",
            "displayFolder": "Snapshot metrics",
            "expression": "DIVIDE([Snapshot Repeat Buyers],[Snapshot Buyers])",
            "formatString": "0.0%",
            "lineageTag": "8615bd41-bf88-43ae-a334-d33280f5a6ca"
          },
          {
            "name": "Snapshot Gross Sales GBP",
            "displayFolder": "Snapshot metrics",
            "expression": "DIVIDE(SUM(Customers[monetary_pence]),100)",
            "formatString": "£#,0.00;(£#,0.00);£0.00",
            "lineageTag": "374b588a-f677-470d-8464-418767850081"
          }
        ],
        "partitions": [
          {
            "name": "rfm_customers",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ProjectRoot & \"\\data\\processed\\rfm_customers.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"customer_id\", type text}, {\"last_purchase\", type datetime}, {\"first_purchase\", type datetime}, {\"frequency\", Int64.Type}, {\"monetary_pence\", Int64.Type}, {\"recency_days\", Int64.Type}, {\"r_score\", Int64.Type}, {\"f_score\", Int64.Type}, {\"m_score\", Int64.Type}, {\"rfm_score\", type text}, {\"segment\", type text}, {\"monetary_gbp\", type number}}, \"en-GB\")",
                "in",
                "    Types"
              ],
              "type": "m"
            }
          }
        ]
      },
