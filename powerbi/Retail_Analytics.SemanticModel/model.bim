        "lineageTag": "f5e62d16-8fbd-423b-8ab8-ad60c6826e2b",
        "partitions": [
          {
            "name": "Calendar",
            "source": {
              "expression": "ADDCOLUMNS(CALENDAR(MIN(Ledger[order_date]),MAX(Ledger[order_date])),\"Year\",YEAR([Date]),\"Month\",FORMAT([Date],\"yyyy-MM\"),\"Month Sort\",YEAR([Date])*100+MONTH([Date]))",
